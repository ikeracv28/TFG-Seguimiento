# ============================================================
# Nexus TFG — Variables de entorno
# Copia este fichero a .env y rellena los valores
# ============================================================

# Base de datos
DB_USER=postgres
DB_PASSWORD=CAMBIAR_AQUI
DB_NAME=tfg_db
DB_PORT=5432

# Backend Spring Boot
SPRING_PORT=8080
JWT_SECRET=BASE64_DE_AL_MENOS_32_CARACTERES_OBLIGATORIO

# CORS — origen permitido (frontend)
ALLOWED_ORIGIN=http://localhost:3000

# Frontend Flutter / Nginx
FLUTTER_PORT=3000
API_URL=http://localhost:8080/api/v1
