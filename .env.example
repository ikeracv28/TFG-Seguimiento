# =========================================================================
# CONFIGURACIÓN DE ENTORNO - NEXUS TFG (PLANTILLA)
# =========================================================================
# Copia este archivo a .env y rellena con tus valores locales.
# NO subir el archivo .env final al repositorio.

# 1. Base de Datos (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=password_change_me
DB_NAME=tfg_db
DB_PORT=5432

# 2. Backend (Spring Boot)
SPRING_PORT=8080
JWT_SECRET=your_secret_key_here_min_64_chars_recommended

# 3. Frontend (Flutter Web)
FLUTTER_PORT=3000
API_URL=http://localhost:8080/api/v1
